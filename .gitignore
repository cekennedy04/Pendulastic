_pendulum_preview.png
Untitled-*.yaml
_smoke_test.py
_e2e_test.py
_real_test.py
_mp_diag.py

# Virtual environments
.venv/
venv/
env/

# JS/Node dependencies (mobile app, web frontend)
node_modules/
.expo/

# Participant / session data — never commit
# The `.*` globs catch backup/temp copies (mas_scores.csv.bak-...); the exact-name
# rules alone leave those untracked but committable.
sessions.json
sessions.json.*
uploads/
mas_scores.csv
mas_scores.csv.*
participant_groups.json
participant_groups.json.*

# Self-signed TLS cert/key for the phone-camera stream server — generated
# at runtime, regenerated per-machine/per-IP, never committed.
.certs/
OptiTrack_Tracking_Data_Participant_0/
P001_MSParticipant2_history.csv
tracking_selections.json
imu_calibration_config.json
imu_calibration_config.json.tmp
sweep_cache/
rmse_best_config.json
calibration_coefficients*.json

# Large outputs and scratch
# Contents, not the directory itself. git cannot re-include a file whose
# PARENT is excluded, so `Model_Analysis_Outputs/` followed by a negation
# silently does nothing -- the trailing-slash form has to become /* for the
# exception below to take effect at all.
Model_Analysis_Outputs/*
# ...except the manifest: a small text record of WHAT was generated and from
# which commit. The directory is ~239 MB of regenerable PNGs and stays out, but
# leaving it wholly unrecorded cost a real answer once -- a results table was
# overwritten before it could be diffed against the previous run.
!Model_Analysis_Outputs/manifest.json
pendulastic model analysis/
pendulastic_model_analysis_outputs.zip
STCFormer-main.zip
data/
figures/
training_data/

# Log files
*.log

# Temp / meta
meta_tmp.txt
pip_install_log.txt

# Claude session files
.claude/

# Skill-local scratch/session state (codex session continuity, superpowers
# sdd scratch space — the latter already self-excludes via its own nested
# .superpowers/sdd/.gitignore; this formalizes the same intent at the root
# so it stops showing as untracked noise in git status)
.context/
.superpowers/

# Isolated worktrees for plan execution
.worktrees/

# Local secrets
.env
.gstack/

# Mobile harness build artifacts (U0 throwaway capture harness)
mobile-imu-core/harness-android/.gradle/
mobile-imu-core/harness-android/build/
mobile-imu-core/harness-android/app/build/
mobile-imu-core/harness-android/local.properties
mobile-imu-core/harness-ios/*.xcodeproj/
mobile-imu-core/harness-ios/build/
mobile-imu-core/target/

# Generated wasm bindings for the web capture app. Built by
# `npm run build:wasm` from webapp/ (and by CI before the webapp tests run);
# never committed. The .wasm is not reproducible across machines -- it embeds
# the building machine's cargo registry path, source paths with that OS's
# separators, and a rustc version/commit string -- so a committed copy can
# only ever be one machine's bytes masquerading as canonical.
webapp/src/wasm/

# Raw IMU trials captured via the webapp's "Send to laptop" /upload route
# (dev_server.py). Participant-adjacent data -- must never be committed.
webapp/captures/

# Built static-deploy output (npm run build:dist). Regenerable. Already
# matched incidentally by the bare `dist/` under # Python, but named here so
# moving or scoping that line cannot silently make a deploy artifact
# committable.
webapp/dist/
*.err
.vercel
.env*

# LabVIEW motor-rig .bin stretch trials + generated decoded/ output (~140 MB raw data)
ck_app_pt_test/

# Regenerable run output (sweep logs, analysis stdout, one-off check images)
sweep_resume_log*.txt
*_output.txt
opensim_ik*.txt
lateral_impact_presentation*.png
oneoff_lateral_check*.png

# Bench/phone trial data, personal to-do files, generated figures, scratch outputs
Pendulastic_Mobile_App_Trial/
to_do/
bench_figures/
ab_*.csv
preamble_out.csv
x.png
excluded_trials.json.bak-*
