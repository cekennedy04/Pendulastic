# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Generated acquisition output
Recordings/
OptiTrack_Recordings/

# Longitudinal dashboard participant history (real clinical data; never committed)
participants/

# Downloaded model weights (large; fetched by download_models.py)
models/

